<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <CelestePrefix Condition="'$(CelestePrefix)' == ''">$(CELESTE_DIR)</CelestePrefix>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(CelestePrefix)/Celeste.dll" Publicize="true" />
    <Reference Include="$(CelestePrefix)/FNA.dll" Publicize="true" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.1" PrivateAssets="all" ExcludeAssets="runtime" />
    <Compile Include="../../game-bridge/Source/InputFrame.cs" Link="InputFrame.cs" />
    <Compile Include="../../game-bridge/Source/InputInjector.cs" Link="InputInjector.cs" />
  </ItemGroup>
</Project>
