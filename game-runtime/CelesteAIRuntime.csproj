<Project Sdk="Microsoft.NET.Sdk">
  <!-- 与桥接共用本机游戏路径：game-bridge/local.props（不入库）；也可在本目录另放 local.props -->
  <Import Project="../game-bridge/local.props" Condition="Exists('../game-bridge/local.props')" />
  <Import Project="local.props" Condition="Exists('local.props')" />
  <PropertyGroup>
    <AssemblyName>CelesteAIRuntime</AssemblyName>
    <RootNamespace>CelesteAI.Bridge</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <Version>1.0.5</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Payload-only commits must not change the resident DLL's debug identity. -->
    <EnableSourceLink>false</EnableSourceLink>
    <!-- The PE embeds the PDB path and a PDB id derived from source paths; map the
         checkout root so the hot-reload hash check does not depend on where the repo lives. -->
    <CelesteAIRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../'))</CelesteAIRepoRoot>
    <PathMap>$(CelesteAIRepoRoot)=/_/</PathMap>
    <CelestePrefix Condition="'$(CelestePrefix)' == ''">$(CELESTE_DIR)</CelestePrefix>
    <CelestePrefix Condition="'$(CelestePrefix)' == ''">..\..\Celeste</CelestePrefix>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(CelestePrefix)/Celeste.dll" Private="false" Publicize="true" />
    <Reference Include="$(CelestePrefix)/FNA.dll" Private="false" Publicize="true" />
    <Reference Include="$(CelestePrefix)/MMHOOK_Celeste.dll" Private="false" />
    <PackageReference Include="MonoMod.RuntimeDetour" Version="25.3.1" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.1" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../game-bridge/Source/RecordingAudio.cs" Link="RecordingAudio.cs" />
    <Compile Include="../game-bridge/Source/RecordingBanks.cs" Link="RecordingBanks.cs" />
    <Compile Include="../game-bridge/Source/RecordingMixSnapshot.cs" Link="RecordingMixSnapshot.cs" />
    <Compile Include="../game-bridge/Source/IpcServer.cs" Link="IpcServer.cs" />
    <Compile Include="../game-bridge/Source/ClockServer.cs" Link="ClockServer.cs" />
    <Compile Include="../game-bridge/Source/InputFrame.cs" Link="InputFrame.cs" />
    <Compile Include="../game-bridge/Source/InputInjector.cs" Link="InputInjector.cs" />
  </ItemGroup>
  <Target Name="CopyToModBin" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll;$(OutputPath)$(AssemblyName).pdb" DestinationFolder="$(MSBuildThisFileDirectory)bin" />
  </Target>
</Project>
