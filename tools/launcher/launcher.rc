#pragma code_page(65001)
#include <windows.h>

#ifdef HUD_LAUNCHER
#define DESCRIPTION "Celeste AI HUD"
#define ORIGINAL_FILENAME "CelesteAIHud.exe"
#define APP_VERSION 1,0,1,0
#define APP_VERSION_TEXT "1.0.1"
#else
#define DESCRIPTION "Celeste AI 控制台"
#define ORIGINAL_FILENAME "CelesteAIConsole.exe"
#define APP_VERSION 1,11,0,0
#define APP_VERSION_TEXT "1.11.0"
#endif

1 ICON "icon.ico"
1 RT_MANIFEST "launcher.manifest"

1 VERSIONINFO
FILEVERSION APP_VERSION
PRODUCTVERSION APP_VERSION
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"
    BEGIN
      VALUE "FileDescription", DESCRIPTION
      VALUE "ProductName", "Celeste AI Play"
      VALUE "OriginalFilename", ORIGINAL_FILENAME
      VALUE "FileVersion", APP_VERSION_TEXT
      VALUE "ProductVersion", APP_VERSION_TEXT
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x804, 1200
  END
END
